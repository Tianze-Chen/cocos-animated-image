{
    "name": "animated-image",
    "package_version": 2,
    "version": "1.1.0",
    "description": "AnimatedImage — GIF / APNG / WebP / PNG / JPEG animated image player for Cocos Creator 3.8.x. TypeScript runtime mounted read-only via asset-db.mount, with WebP decoded by wasm off-native and by a native C++ plugin on native. Unwanted formats can be trimmed out of the build from 面板 → AnimatedImage 格式.",
    "author": "animated-image",
    "main": "./main.js",
    "editor": ">=3.8.0",
    "panels": {
        "formats": {
            "title": "AnimatedImage 格式",
            "type": "simple",
            "main": "./panels/formats.js",
            "size": {
                "min-width": 420,
                "min-height": 320,
                "width": 480,
                "height": 400
            }
        }
    },
    "contributions": {
        "asset-db": {
            "mount": {
                "path": "./runtime",
                "readonly": true
            }
        },
        "native": {
            "plugins": {
                "animated-webp": {
                    "cc_plugin.json": "./native/cc_plugin.json"
                }
            }
        },
        "builder": "./editor/build/builder.js",
        "menu": [
            {
                "path": "i18n:menu.panel/AnimatedImage",
                "label": "格式裁剪",
                "message": "open-formats"
            }
        ],
        "messages": {
            "open-formats": {
                "methods": [
                    "openFormats"
                ]
            },
            "query-formats": {
                "methods": [
                    "queryFormats"
                ]
            },
            "apply-formats": {
                "methods": [
                    "applyFormats"
                ]
            }
        },
        "profile": {
            "project": {
                "formats": {
                    "default": {
                        "gif": true,
                        "apng": true,
                        "webp": false,
                        "demo": true
                    }
                }
            }
        }
    }
}
